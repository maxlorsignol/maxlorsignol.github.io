library(lidR)
library(terra)
library(tidyverse)
library(rgl)
install.packages("rgl")
library(dplyr)
library(leaflet)
library(sf)
library(raster)
library(leaflet.extras)
library(RColorBrewer)
# Define the path to your files
# Update these paths to match where your files are located
shapefile_dir <- "~/Desktop/QGIS/grizzly least cost"  # Update this path to your directory
# Load the vector files using sf::st_read()
# BMA perimeter
bma_perimeter <- st_read(
file.path(shapefile_dir, "/yellowhead_bma.shp"),
quiet = TRUE
) %>%
# Ensure the CRS is WGS84 (EPSG:4326) for leaflet compatibility
st_transform(crs = 4326)
# Source point
source_point <- st_read(
file.path(shapefile_dir, "/source_point.shp"),
quiet = TRUE
) %>%
st_transform(crs = 4326)
# Target point
target_point <- st_read(
file.path(shapefile_dir, "/target_point.shp"),
quiet = TRUE
) %>%
st_transform(crs = 4326)
# Least cost path
path <- st_read(
file.path(shapefile_dir, "/least_cost_path.shp"),
quiet = TRUE
) %>%
st_transform(crs = 4326)
# Load the raster files
# Land cover classification
landcover <- raster(file.path(shapefile_dir, "/ca_forest_vlce_2019.tif"))
# landcover <- projectRaster(landcover, crs = "+proj=longlat +datum=WGS84")
# Cost raster
cost_raster <- raster(file.path(shapefile_dir, "/yellowhead_cost_raster_aoi.tif"))
# cost_raster <- projectRaster(cost_raster, crs = "+proj=longlat +datum=WGS84")
# Create color palettes for the rasters
# Land cover classification - assuming categorical data
landcover_classes <- unique(values(landcover))
landcover_colors <- colorFactor(
palette = brewer.pal(length(landcover_classes), "Set3"),
domain = landcover_classes
)
# Cost raster - continuous data
cost_colors <- colorNumeric(
palette = "Greys",
domain = values(cost_raster),
na.color = "transparent"
)
# Create the map
grizzly_path_map <- leaflet() %>%
addProviderTiles("CartoDB.Positron", group = "Base Map") %>%
addProviderTiles("Esri.WorldImagery", group = "Satellite") %>%
# Add BMA perimeter
addPolygons(
data = bma_perimeter,
fillColor = "blue",
color = "darkblue",
weight = 2,
opacity = 0.8,
fillOpacity = 0.2,
group = "BMA Perimeter",
label = "Bear Management Area",
highlightOptions = highlightOptions(
weight = 3,
color = "#666",
fillOpacity = 0.5,
bringToFront = TRUE
)
) %>%
# Add source point
addCircleMarkers(
data = source_point,
color = "green",
radius = 8,
stroke = TRUE,
weight = 2,
opacity = 1,
fillOpacity = 0.8,
group = "Source/Target Points",
label = ~paste0(points$type, " point: ", points$name),
popup = ~paste0("<strong>", toupper(points$type), " POINT</strong><br>",
"Name: ", points$name, "<br>",
"Description: ", points$description)
) %>%  # Add target point
addCircleMarkers(
data = target_point,
color = "red",
radius = 8,
stroke = TRUE,
weight = 2,
opacity = 1,
fillOpacity = 0.8,
group = "Source/Target Points",
label = ~paste0(points$type, " point: ", points$name),
popup = ~paste0("<strong>", toupper(points$type), " POINT</strong><br>",
"Name: ", points$name, "<br>",
"Description: ", points$description)
) %>%
# Add least cost path
addPolylines(
data = path,
color = "purple",
weight = 4,
opacity = 0.8,
group = "Least Cost Path",
label = "Optimal Movement Corridor",
popup = ~paste0("<strong>LEAST COST PATH</strong><br>",
"Length: ", round(path$length_km, 2), " km<br>",
"Cost value: ", round(path$cost_value, 2))
) %>%
# Add land cover raster
addRasterImage(
landcover,
colors = landcover_colors,
opacity = 0.7,
group = "Land Cover"
) %>%
# Add cost raster
addRasterImage(
cost_raster,
colors = cost_colors,
opacity = 0.7,
group = "Cost Surface"
) %>%
# Set the view to center on Alberta (these coordinates may need adjustment)
setView(lng = -115.0, lat = 55.0, zoom = 7) %>%
# Add map controls
addLayersControl(
baseGroups = c("Base Map", "Satellite"),
overlayGroups = c("BMA Perimeter", "Source/Target Points", "Least Cost Path", "Land Cover", "Cost Surface"),
options = layersControlOptions(collapsed = FALSE)
) %>%
# Hide rasters by default as they can be heavy to load
hideGroup("Land Cover") %>%
hideGroup("Cost Surface") %>%
# Add measurement tools and other controls
addMeasure(
position = "bottomleft",
primaryLengthUnit = "kilometers",
primaryAreaUnit = "sqkilometers"
) %>%
addScaleBar(position = "bottomleft") %>%
addFullscreenControl() %>%
addResetMapButton() %>%
# Add a legend for the land cover classification
addLegend(
position = "bottomright",
colors = brewer.pal(length(landcover_classes), "Set3"),
labels = paste("Class", landcover_classes),
title = "Land Cover Types",
opacity = 0.7,
group = "Land Cover"
) %>%
# Add a legend for the cost surface
addLegend(
position = "bottomright",
colors = colorNumeric("Greys", c(min(values(cost_raster), na.rm = TRUE),
max(values(cost_raster), na.rm = TRUE)))(seq(
min(values(cost_raster), na.rm = TRUE),
max(values(cost_raster), na.rm = TRUE)
)),
labels = round(seq(
min(values(cost_raster), na.rm = TRUE),
max(values(cost_raster), na.rm = TRUE)
), 1),
title = "Movement Cost",
opacity = 0.7,
group = "Cost Surface"
)
library(dplyr)
library(leaflet)
library(sf)
library(raster)
library(leaflet.extras)
library(RColorBrewer)
# ---------- File Paths ----------
shapefile_dir <- "~/Desktop/QGIS/grizzly least cost"
# ---------- Helper: Read and transform shapefile ----------
read_sf_4326 <- function(path) {
st_read(path, quiet = TRUE) %>% st_transform(crs = 4326)
}
# ---------- Load Vector Data ----------
bma_perimeter <- read_sf_4326(file.path(shapefile_dir, "yellowhead_bma.shp"))
source_point <- read_sf_4326(file.path(shapefile_dir, "source_point.shp"))
target_point <- read_sf_4326(file.path(shapefile_dir, "target_point.shp"))
path <- read_sf_4326(file.path(shapefile_dir, "least_cost_path.shp"))
# ---------- Load and Prepare Raster Data ----------
aggregate_raster <- function(r, fact = 5) {
aggregate(r, fact = fact, fun = modal)
}
landcover <- raster(file.path(shapefile_dir, "ca_forest_vlce_2019.tif")) %>% aggregate_raster()
cost_raster <- raster(file.path(shapefile_dir, "yellowhead_cost_raster_aoi.tif")) %>% aggregate_raster()
